---
import { getCollection } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import { filterTopicalSources, honestDescription } from '../../lib/citation-honesty.mjs';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft && data.lang === 'en');

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const description = honestDescription(post.data.description);
const topicalLinks = filterTopicalSources(post.data.sourceLinks, {
  title: post.data.title,
  tags: post.data.tags,
});
const canonical = `https://greatindiancompany.com/blog/${post.slug}`;
const words = post.body ? post.body.trim().split(/\s+/).filter(Boolean).length : 0;
const readTime = Math.max(2, Math.round(words / 220));
---

<BlogLayout title={post.data.title} description={description} canonical={canonical}>
  <article class="card article-shell">
    <p class="eyebrow">English template</p>
    <h1>{post.data.title}</h1>
    <p class="meta lead">{description}</p>

    <div class="meta-pills">
      <span class="pill">Published: {post.data.publishDate}</span>
      <span class="pill">Read Time: {readTime} min</span>
      <span class="pill">Language: English</span>
    </div>

    <div class="tags">
      {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
    </div>

    <div class="divider"></div>

    <div class="post-body">
      <Content />
    </div>

    <section class="sources">
      {
        topicalLinks.length > 0 ? (
          <>
            <h2>Topic-matched links</h2>
            <p class="meta">
              Shown because the site matches this brief's topic. The pipeline does not verify that the page supports the text.
            </p>
            <ul class="source-list">
              {topicalLinks.map((url) => (
                <li>
                  <a href={url} target="_blank" rel="noopener noreferrer">
                    {url}
                  </a>
                </li>
              ))}
            </ul>
          </>
        ) : (
          <>
            <h2>Citations</h2>
            <p class="meta">
              Registry links for this brief are not shown. They were not matched to this topic, and this page does not add replacement sources.
            </p>
          </>
        )
      }
    </section>

    <div class="article-foot">
      <a class="back-link" href="/blog">
        Browse all briefs
      </a>
    </div>
  </article>

  <style>
    .article-shell {
      position: relative;
      overflow: hidden;
    }

    .article-shell::before {
      content: '';
      position: absolute;
      width: 280px;
      height: 280px;
      border-radius: 999px;
      right: -120px;
      top: -140px;
      background: radial-gradient(circle, rgba(241, 202, 151, 0.3), rgba(255, 255, 255, 0));
      pointer-events: none;
    }

    .eyebrow {
      margin: 0 0 0.45rem;
      text-transform: uppercase;
      letter-spacing: 0.13em;
      font-size: 0.72rem;
      color: #8f6f4f;
      font-weight: 700;
    }

    .lead {
      margin: 0;
      max-width: 70ch;
    }

    .divider {
      margin: 1.25rem 0 0.3rem;
      border-top: 1px solid #dbc8ad;
    }

    .sources {
      margin-top: 1.75rem;
    }

    .sources h2 {
      margin: 0 0 0.65rem;
      font-size: 1.45rem;
    }

    .article-foot {
      margin-top: 1.3rem;
      border-top: 1px solid #dbc8ad;
      padding-top: 0.9rem;
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      border: 1px solid #c8a371;
      border-radius: 999px;
      background: #fff;
      padding: 0.45rem 0.78rem;
      font-size: 0.82rem;
      font-weight: 700;
      color: #7e4310;
    }

    .back-link:hover {
      background: #fff3e3;
    }
  </style>
</BlogLayout>
