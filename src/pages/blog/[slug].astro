---
import { getCollection } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import { filterTopicalSources, honestDescription } from '../../lib/citation-honesty.mjs';

const SITE = 'https://greatindiancompany.com';

export async function getStaticPaths() {
  const posts = await getCollection(
    'blog',
    ({ data }) => !data.draft && (data.lang === 'en' || data.lang === 'hi'),
  );
  const byId = new Map(posts.map((entry) => [entry.data.id, entry]));

  return posts.map((post) => {
    const english = post.data.lang === 'en' ? post : byId.get(post.data.translationOf ?? '') ?? null;
    const hindi =
      post.data.lang === 'hi'
        ? post
        : posts.find((entry) => entry.data.lang === 'hi' && entry.data.translationOf === post.data.id) ?? null;

    return {
      params: { slug: post.slug },
      props: {
        post,
        englishSlug: english?.slug ?? null,
        hindiSlug: hindi?.slug ?? null,
      },
    };
  });
}

const { post, englishSlug, hindiSlug } = Astro.props;
const { Content } = await post.render();
const description = honestDescription(post.data.description);
const topicalLinks = filterTopicalSources(post.data.sourceLinks, {
  title: post.data.title,
  tags: post.data.tags,
});
const canonical = `${SITE}/blog/${post.slug}`;
const words = post.body ? post.body.trim().split(/\s+/).filter(Boolean).length : 0;
const readTime = Math.max(2, Math.round(words / 220));
const isHindi = post.data.lang === 'hi';
const pairedSlug = isHindi ? englishSlug : hindiSlug;
const alternates =
  englishSlug && hindiSlug
    ? [
        { hreflang: 'en', href: `${SITE}/blog/${englishSlug}` },
        { hreflang: 'hi', href: `${SITE}/blog/${hindiSlug}` },
        { hreflang: 'x-default', href: `${SITE}/blog/${englishSlug}` },
      ]
    : [];
const ui = isHindi
  ? {
      eyebrow: 'हिन्दी अनुवाद',
      published: 'प्रकाशन',
      readTime: 'पढ़ने का समय',
      minute: 'मिनट',
      language: 'भाषा: हिन्दी',
      linksHeading: 'विषय से मेल खाते लिंक',
      linksNote:
        'ये लिंक इसलिए दिखाए गए हैं क्योंकि साइट इस ब्रीफ के विषय से इन्हें मिलाती है। पाइपलाइन यह जाँच नहीं करती कि पन्ना पाठ का समर्थन करता है।',
      citationsHeading: 'उद्धरण',
      citationsNote:
        'इस ब्रीफ के रजिस्ट्री लिंक नहीं दिखाए गए। वे इस विषय से मेल नहीं खाते, और यह पन्ना उनकी जगह नया स्रोत नहीं जोड़ता।',
      browse: 'सभी ब्रीफ देखें',
      footer:
        'ग्रेट इंडियन कंपनी का हिन्दी अनुवाद। लिंक तभी दिखता है जब वह ब्रीफ के विषय से मेल खाता है।',
      switchLabel: 'English',
      switchLang: 'en',
    }
  : {
      eyebrow: 'English template',
      published: 'Published',
      readTime: 'Read Time',
      minute: 'min',
      language: 'Language: English',
      linksHeading: 'Topic-matched links',
      linksNote:
        "Shown because the site matches this brief's topic. The pipeline does not verify that the page supports the text.",
      citationsHeading: 'Citations',
      citationsNote:
        'Registry links for this brief are not shown. They were not matched to this topic, and this page does not add replacement sources.',
      browse: 'Browse all briefs',
      footer:
        'English templates by Great Indian Company. Citations appear only when a link matches the brief topic.',
      switchLabel: 'हिन्दी',
      switchLang: 'hi',
    };
---

<BlogLayout
  title={post.data.title}
  description={description}
  canonical={canonical}
  lang={post.data.lang}
  alternates={alternates}
  footerNote={ui.footer}
>
  <article class="card article-shell">
    <p class="eyebrow">{ui.eyebrow}</p>
    <h1>{post.data.title}</h1>
    <p class="meta lead">{description}</p>

    <div class="meta-pills">
      <span class="pill">{ui.published}: {post.data.publishDate}</span>
      <span class="pill">{ui.readTime}: {readTime} {ui.minute}</span>
      <span class="pill">{ui.language}</span>
      {
        pairedSlug && (
          <a class="pill lang-switch" href={`/blog/${pairedSlug}`} hreflang={ui.switchLang} lang={ui.switchLang}>
            {ui.switchLabel}
          </a>
        )
      }
    </div>

    <div class="tags">
      {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
    </div>

    <div class="divider"></div>

    <div class="post-body">
      <Content />
    </div>

    <section class="sources">
      {
        topicalLinks.length > 0 ? (
          <>
            <h2>{ui.linksHeading}</h2>
            <p class="meta">{ui.linksNote}</p>
            <ul class="source-list">
              {topicalLinks.map((url) => (
                <li>
                  <a href={url} target="_blank" rel="noopener noreferrer">
                    {url}
                  </a>
                </li>
              ))}
            </ul>
          </>
        ) : (
          <>
            <h2>{ui.citationsHeading}</h2>
            <p class="meta">{ui.citationsNote}</p>
          </>
        )
      }
    </section>

    <div class="article-foot">
      <a class="back-link" href="/blog">
        {ui.browse}
      </a>
    </div>
  </article>

  <style>
    .article-shell {
      position: relative;
      overflow: hidden;
    }

    .article-shell::before {
      content: '';
      position: absolute;
      width: 280px;
      height: 280px;
      border-radius: 999px;
      right: -120px;
      top: -140px;
      background: radial-gradient(circle, rgba(241, 202, 151, 0.3), rgba(255, 255, 255, 0));
      pointer-events: none;
    }

    .eyebrow {
      margin: 0 0 0.45rem;
      text-transform: uppercase;
      letter-spacing: 0.13em;
      font-size: 0.72rem;
      color: #8f6f4f;
      font-weight: 700;
    }

    .lead {
      margin: 0;
      max-width: 70ch;
    }

    .divider {
      margin: 1.25rem 0 0.3rem;
      border-top: 1px solid #dbc8ad;
    }

    .sources {
      margin-top: 1.75rem;
    }

    .sources h2 {
      margin: 0 0 0.65rem;
      font-size: 1.45rem;
    }

    .article-foot {
      margin-top: 1.3rem;
      border-top: 1px solid #dbc8ad;
      padding-top: 0.9rem;
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      border: 1px solid #c8a371;
      border-radius: 999px;
      background: #fff;
      padding: 0.45rem 0.78rem;
      font-size: 0.82rem;
      font-weight: 700;
      color: #7e4310;
    }

    .back-link:hover {
      background: #fff3e3;
    }

    .lang-switch {
      color: #7e4310;
      font-weight: 700;
    }
  </style>
</BlogLayout>
