---
import { getCollection } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import { filterTopicalSources, honestDescription } from '../../lib/citation-honesty.mjs';
import { chromeFor } from '../../lib/i18n-chrome.mjs';
import { assessReviewedTranslation, contentBasename, hreflangAlternates, languageSwitchLinks } from '../../lib/i18n-contract.mjs';
import { pageLanguage, scheduledLanguageCodes } from '../../lib/i18n-languages.mjs';

const SITE = 'https://greatindiancompany.com';

export async function getStaticPaths() {
  const scheduledCodes = scheduledLanguageCodes();
  const scheduled = new Set(scheduledCodes);
  const allPosts = await getCollection('blog');
  const englishById = new Map(
    allPosts.filter((post) => post.data.lang === 'en').map((post) => [post.data.id, post]),
  );

  for (const post of allPosts) {
    if (post.data.lang === 'en') {
      continue;
    }

    const folder = post.id.includes('/') ? post.id.split('/')[0] : '';
    const filename = `${contentBasename(post.id)}.md`;
    const englishEntry = englishById.get(post.data.translationOf);
    const english = englishEntry
      ? {
          id: englishEntry.data.id,
          slug: englishEntry.slug,
          basename: contentBasename(englishEntry.id),
          draft: englishEntry.data.draft === true,
        }
      : null;
    const assessment = assessReviewedTranslation({
      lang: post.data.lang,
      folder,
      filename,
      id: post.data.id,
      slug: post.slug,
      translationOf: post.data.translationOf,
    }, { english });

    if (!assessment.ok) {
      throw new Error(`Refusing ${post.id}. ${assessment.errors.join(' ')}`);
    }

    for (const warning of assessment.warnings) {
      console.warn(`Reviewed translation ${post.id}: ${warning}`);
    }
  }

  const posts = allPosts.filter(
    (post) => !post.data.draft && (post.data.lang === 'en' || scheduled.has(post.data.lang)),
  );
  const publishedEnglishById = new Map(
    posts.filter((post) => post.data.lang === 'en').map((post) => [post.data.id, post]),
  );
  const translationsByEnglishId = new Map();
  for (const post of posts) {
    if (post.data.lang === 'en') {
      continue;
    }
    const key = post.data.translationOf;
    const group = translationsByEnglishId.get(key) ?? [];
    group.push(post);
    translationsByEnglishId.set(key, group);
  }

  return posts.map((post) => {
    const englishId = post.data.lang === 'en' ? post.data.id : post.data.translationOf;
    const englishPost = publishedEnglishById.get(englishId) ?? null;
    const translations = (translationsByEnglishId.get(englishId) ?? [])
      .slice()
      .sort((left, right) => scheduledCodes.indexOf(left.data.lang) - scheduledCodes.indexOf(right.data.lang))
      .map((entry) => {
        const language = pageLanguage(entry.data.lang);
        return {
          code: language.code,
          slug: entry.slug,
          nativeName: language.nativeName,
          dir: language.dir,
        };
      });

    return {
      params: { slug: post.slug },
      props: {
        post,
        englishSlug: englishPost?.slug ?? null,
        translations,
      },
    };
  });
}

const { post, englishSlug, translations } = Astro.props;
const { Content } = await post.render();
const description = honestDescription(post.data.description);
const topicalLinks = filterTopicalSources(post.data.sourceLinks, {
  title: post.data.title,
  tags: post.data.tags,
});
const canonical = `${SITE}/blog/${post.slug}`;
const words = post.body ? post.body.trim().split(/\s+/).filter(Boolean).length : 0;
const readTime = Math.max(2, Math.round(words / 220));
const language = pageLanguage(post.data.lang);
const ui = chromeFor(post.data.lang);
const alternates = hreflangAlternates({
  english: englishSlug ? { slug: englishSlug } : null,
  translations,
  siteUrl: SITE,
});
const switchLinks = languageSwitchLinks({
  currentCode: post.data.lang,
  english: englishSlug ? { slug: englishSlug } : null,
  translations,
});
const fontSans = language.fontFamilies[0] ?? null;
const fontSerif = language.fontFamilies[1] ?? language.fontFamilies[0] ?? null;
---

<BlogLayout
  title={post.data.title}
  description={description}
  canonical={canonical}
  lang={language.hreflang}
  dir={language.dir}
  alternates={alternates}
  fontStylesheet={language.fontStylesheet}
  fontSans={fontSans}
  fontSerif={fontSerif}
  footerNote={ui.footer}
  nav={{
    home: ui.home,
    allBriefs: ui.allBriefs,
    sitemap: ui.sitemap,
    researchDesk: ui.researchDesk,
  }}
>
  <article class="card article-shell">
    <p class="eyebrow">{ui.eyebrow}</p>
    {
      post.data.lang !== 'en' && (
        <p class="translation-note">
          {ui.machineNote}{' '}
          {englishSlug && (
            <a href={`/blog/${englishSlug}`} hreflang="en" lang="en">
              {ui.englishOriginal}
            </a>
          )}
        </p>
      )
    }
    <h1>{post.data.title}</h1>
    <p class="meta lead">{description}</p>

    <div class="meta-pills">
      <span class="pill">{ui.published}: {post.data.publishDate}</span>
      <span class="pill">{ui.readTime}: {readTime} {ui.minute}</span>
      <span class="pill">{ui.language}: {language.nativeName}</span>
      {
        switchLinks.length > 0 && (
          <nav class="lang-switch" aria-label={ui.languagesLabel}>
            {switchLinks.map((link) => (
              <a class="pill lang-switch-link" href={`/blog/${link.slug}`} hreflang={link.hreflang} lang={link.code} dir={link.dir}>
                {link.label}
              </a>
            ))}
          </nav>
        )
      }
    </div>

    <div class="tags">
      {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
    </div>

    <div class="divider"></div>

    <div class="post-body">
      <Content />
    </div>

    <section class="sources">
      {
        topicalLinks.length > 0 ? (
          <>
            <h2>{ui.linksHeading}</h2>
            <p class="meta">{ui.linksNote}</p>
            <ul class="source-list">
              {topicalLinks.map((url) => (
                <li>
                  <a href={url} target="_blank" rel="noopener noreferrer">
                    {url}
                  </a>
                </li>
              ))}
            </ul>
          </>
        ) : (
          <>
            <h2>{ui.citationsHeading}</h2>
            <p class="meta">{ui.citationsNote}</p>
          </>
        )
      }
    </section>

    <div class="article-foot">
      <a class="back-link" href="/blog">
        {ui.browse}
      </a>
    </div>
  </article>

  <style>
    .article-shell {
      position: relative;
      overflow: hidden;
    }

    .article-shell::before {
      content: '';
      position: absolute;
      width: 280px;
      height: 280px;
      border-radius: 999px;
      right: -120px;
      top: -140px;
      background: radial-gradient(circle, rgba(241, 202, 151, 0.3), rgba(255, 255, 255, 0));
      pointer-events: none;
    }

    .eyebrow {
      margin: 0 0 0.45rem;
      text-transform: uppercase;
      letter-spacing: 0.13em;
      font-size: 0.72rem;
      color: #8f6f4f;
      font-weight: 700;
    }

    .translation-note {
      margin: 0 0 0.85rem;
      color: #6d542f;
      font-size: 0.95rem;
    }

    .lead {
      margin: 0;
      max-width: 70ch;
    }

    .divider {
      margin: 1.25rem 0 0.3rem;
      border-top: 1px solid #dbc8ad;
    }

    .sources {
      margin-top: 1.75rem;
    }

    .sources h2 {
      margin: 0 0 0.65rem;
      font-size: 1.45rem;
    }

    .article-foot {
      margin-top: 1.3rem;
      border-top: 1px solid #dbc8ad;
      padding-top: 0.9rem;
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      border: 1px solid #c8a371;
      border-radius: 999px;
      background: #fff;
      padding: 0.45rem 0.78rem;
      font-size: 0.82rem;
      font-weight: 700;
      color: #7e4310;
    }

    .back-link:hover {
      background: #fff3e3;
    }

    .lang-switch {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
    }

    .lang-switch-link {
      color: #7e4310;
      font-weight: 700;
    }
  </style>
</BlogLayout>
